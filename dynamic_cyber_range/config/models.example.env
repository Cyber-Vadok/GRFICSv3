# Copy to models.env and `set -a; . config/models.env; set +a` before running,
# or pass the same values as --base-url / --red-model / --blue-model flags.

# --- Mock (default smoke test, no GPU) -------------------------------------
# Nothing to set: just run `python3 run.py <scenario> --mock`.

# --- Real inference: Qwen3 on an OpenAI-compatible server ------------------
# Point this at your local vLLM / Ollama / llama.cpp / TGI endpoint.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=                       # usually empty for local servers

# Use the EXACT model id your server advertises at GET /v1/models.
# The user asked for a Qwen3 ~27B; common choices on Hugging Face:
#   Qwen/Qwen3-32B              (dense)
#   Qwen/Qwen3-30B-A3B          (MoE, ~3B active - lighter to serve)
#   Qwen/Qwen3-14B              (smaller, if 27-32B won't fit)
RED_MODEL=Qwen/Qwen3-30B-A3B
BLUE_MODEL=Qwen/Qwen3-30B-A3B

LLM_TEMPERATURE=0.6

# Example: serve Qwen3 with vLLM (needs a capable GPU):
#   pip install vllm
#   vllm serve Qwen/Qwen3-30B-A3B --port 8000 --enable-auto-tool-choice
#
# Example: serve with Ollama (CPU/low-VRAM friendly, smaller quant):
#   ollama pull qwen3:30b-a3b
#   ollama serve         # exposes an OpenAI-compatible API on :11434/v1
#   -> set LLM_BASE_URL=http://127.0.0.1:11434/v1 and RED/BLUE_MODEL=qwen3:30b-a3b
